[Unit]
Description=Drive BricoHams revision-A control outputs to reset-safe states
Before=bricohams-radio.service
After=local-fs.target
ConditionPathExists=/etc/bricohams/gpiochip

[Service]
Type=simple
ExecStart=/usr/local/libexec/bricohams-gpio-safe-state
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
