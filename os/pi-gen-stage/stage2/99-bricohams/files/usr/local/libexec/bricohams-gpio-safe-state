#!/usr/bin/python3
"""Apply the frozen revision-A safe output levels, then release GPIO lines."""

import json
import os
import re
import signal
import stat
import sys
import time


CONTRACT_PATH = "/usr/share/bricohams-os/cm5-interface.json"
GPIOCHIP_PATH = "/etc/bricohams/gpiochip"
SAFE_OUTPUTS = {
    "WATCHDOG_HEARTBEAT": (11, "LOW"),
    "MOTOR_ARM_REQUEST": (12, "LOW"),
    "TCA9548A_RESET_N": (13, "HIGH"),
    "PTT_VHF_REQUEST": (22, "LOW"),
    "PTT_UHF_REQUEST": (23, "LOW"),
}


def main():
    if sys.argv[1:]:
        print("Usage: bricohams-gpio-safe-state", file=sys.stderr)
        return 2
    try:
        with open(CONTRACT_PATH, encoding="utf-8") as contract_file:
            contract = json.load(contract_file)
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot read frozen hardware contract {CONTRACT_PATH}") from error

    if (contract.get("board", {}).get("revision") != "A"
            or contract["board"].get("gpioContractStatus") != "frozen for software integration"
            or contract["softwareContract"].get(
                "unverifiedHardwareMustRemainDisabled"
            ) is not True):
        raise RuntimeError("revision-A contract or hardware HOLD status mismatch")
    try:
        descriptor = os.open(
            GPIOCHIP_PATH,
            os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        with os.fdopen(descriptor, "r", encoding="ascii") as gpiochip_file:
            file_info = os.fstat(gpiochip_file.fileno())
            if (not stat.S_ISREG(file_info.st_mode) or file_info.st_uid != 0
                    or stat.S_IMODE(file_info.st_mode) != 0o644):
                raise PermissionError("GPIO chip selection must be a root-owned mode-0644 file")
            gpiochip = gpiochip_file.read()
    except OSError as error:
        raise RuntimeError(f"select a verified local gpiochip in {GPIOCHIP_PATH}") from error
    if not re.fullmatch(r"/dev/gpiochip[0-9]+\n", gpiochip):
        raise RuntimeError("selected GPIO chip must be one exact /dev/gpiochipN path")
    gpiochip = gpiochip.strip()
    if not stat.S_ISCHR(os.stat(gpiochip, follow_symlinks=False).st_mode):
        raise RuntimeError(f"selected GPIO chip is not a character device: {gpiochip}")

    gpio = {
        entry.get("signal"): entry
        for entry in contract.get("gpio", [])
        if isinstance(entry, dict)
    }
    from gpiod.line import Direction, Value
    import gpiod

    configuration = {}
    expected_values = {}
    for signal, (bcm, safe_level) in SAFE_OUTPUTS.items():
        entry = gpio.get(signal)
        if (entry is None or entry.get("bcm") != bcm
                or entry.get("direction") != "output"
                or entry.get("safeLevel") != safe_level):
            raise RuntimeError(f"frozen safe-state GPIO contract mismatch: {signal}")
        value = Value.INACTIVE if safe_level == "LOW" else Value.ACTIVE
        configuration[bcm] = gpiod.LineSettings(
            direction=Direction.OUTPUT,
            output_value=value,
        )
        expected_values[bcm] = value

    lines = gpiod.request_lines(
        gpiochip,
        consumer="bricohams-safe-state",
        config=configuration,
    )

    stopping = False

    def stop(_signal, _frame):
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        for bcm, value in expected_values.items():
            lines.set_value(bcm, value)
        print(
            f"Revision-A outputs held at reset-safe levels on {gpiochip}: "
            "watchdog LOW, motor arm LOW, TCA reset HIGH, both PTT requests LOW.",
            flush=True,
        )
        while not stopping:
            time.sleep(0.1)
            for bcm, value in expected_values.items():
                lines.set_value(bcm, value)
    finally:
        try:
            for bcm, value in expected_values.items():
                lines.set_value(bcm, value)
        finally:
            # External pulls must keep motor/PTT requests inactive across
            # release, provider reset and power loss. Never configure MCP23017.
            lines.release()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, ImportError) as error:
        print(f"bricohams-gpio-safe-state: {error}", file=sys.stderr)
        raise SystemExit(1)
