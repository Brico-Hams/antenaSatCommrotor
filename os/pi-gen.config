IMG_NAME='bricohams-portablesatstation'
PI_GEN_RELEASE='BricoHams PortableSatStation OS (Raspberry Pi OS derivative)'
RELEASE='trixie'
DEPLOY_COMPRESSION='zip'
STAGE_LIST='stage0 stage1 stage2'

# Default account requested by the project owner: user 'bricohams', password 'Brico123'.
# This is a PUBLISHED, well-known credential: change it on first login (the MOTD says so)
# and keep SSH disabled until you have. Never bake Wi-Fi profiles, SSH keys or tokens.
FIRST_USER_NAME='bricohams'
FIRST_USER_PASS='Brico123'
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=0
PASSWORDLESS_SUDO=0
ENABLE_CLOUD_INIT=1

CONTAINER_NAME='bricohams-pigen'
CONTINUE=0
PRESERVE_CONTAINER=0
